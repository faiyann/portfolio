		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.3",
		"@sveltejs/kit": "^3.0.0",
